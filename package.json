{
  "name": "propertyflow",
  "version": "1.0.0",
  "description": "PropertyFlow - Contractor Job & Work Order Management System",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ..",
    "build": "cd frontend && npm run build",
    "start": "npm run dev"
  },
  "keywords": [
    "property",
    "contractor",
    "management",
    "rental",
    "maintenance"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
